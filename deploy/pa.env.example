# Price Action / SMC katmanı ANA anahtarı.
#
# on  → #3 CHoCH giriş onayı + #4-6 SMC bölge filtresi (>=30) AÇIK
#       ("Smart Money" modu: D bir OB/FVG/Sweep bölgesinde + LTF'de CHoCH onayı
#        olmadan paper'a girilmez)
# off → SALT HARMONİK (eski davranış — sadece Fibonacci/XABCD)
#
# Kurulum (VPS'te, harmonik kullanıcısı):
#   cp deploy/pa.env.example pa.env
#   nano pa.env            # on / off seç
#
# Değiştirdikten sonra:
#   systemctl restart harmonik     # (root) — unit dosyasına dokunmadan toggle
HARMONIK_PRICE_ACTION=off
