[Unit]
Description=harmonik Binance testnet trade hattı (gerçek testnet emirleri)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=harmonik
WorkingDirectory=/home/harmonik/harmonik-binance
Environment=PYTHONUNBUFFERED=1
# Binance TESTNET trading API kimliği (testnet.binancefuture.com → API Key).
# BUNLARI DOLDUR:
Environment=BINANCE_API_KEY=DOLDUR
Environment=BINANCE_SECRET=DOLDUR
# VERİ KAYNAĞI: default mainnet fapi (temiz piyasa yapısı). VPS'ten 451
# (coğrafi engel) gelirse ExecStart'a --testnet-data ekle → testnet kendi
# verisini kullanır (fiyatlar mainnet'i yakından takip eder).
#
# CONFIG = MEXC paper VPS ile AYNI (harmonik.service):
#   rr1 target (PaMonic YOK → worker otomatik rr1), limit giriş, risk $20,
#   paper-min-confluence 0 karşılığı (filtre yok, tüm setuplar). PaMonic'in
#   düşük-WR profili yerine paper'ın iyi sonuç veren config'i.
#   Fark (kaçınılmaz): paper ideal fiyattan %100 dolar; burada GERÇEK limit emir
#   (fiyat D'ye dönerse dolar) + engine-yönetimli exit (testnet native TP/SL yok).
ExecStart=/home/harmonik/harmonik-binance/venv/bin/python -m terminal.cli.run_binance_test \
    --combos-file config/tracked_combos.txt \
    --poll-seconds 30 \
    --stagger-ms 300 \
    --sync-seconds 30 \
    --risk 20 \
    --entry-type limit \
    --log-level INFO
Restart=on-failure
RestartSec=10
TasksMax=2000
LimitNOFILE=65536
StandardOutput=append:/var/log/harmonik/binance.log
StandardError=append:/var/log/harmonik/binance.err

[Install]
WantedBy=multi-user.target
